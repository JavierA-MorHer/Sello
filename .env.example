# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Checkout ya está armado (app/crear/[templateId]/actions.ts) y el
# webhook (app/api/webhooks/stripe/route.ts) es lo único que activa un
# evento. Solo falta pegar las llaves reales aquí, no hay que tocar código.
# - STRIPE_SECRET_KEY: Dashboard de Stripe → Developers → API keys → Secret key.
# - NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY: no se usa todavía (Checkout es hosted,
#   no hace falta Stripe.js en el cliente), pero se deja lista para cuando se
#   quiera un formulario de pago embebido en vez de redirigir a Stripe.
# - STRIPE_WEBHOOK_SECRET: en local, `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
#   te da un secret temporal (whsec_...). En producción, créalo en
#   Dashboard → Developers → Webhooks → Add endpoint (URL: https://misello.com.mx/api/webhooks/stripe,
#   evento a escuchar: checkout.session.completed) y copia el signing secret.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — obligatoria para enviar el correo de confirmación de pago
# (lib/email/resend.ts) y los avisos de vencimiento (cron). Si se deja vacía,
# el código no falla: solo deja de mandar correos (ver console.warn).
RESEND_API_KEY=
# Remitente. "onboarding@resend.dev" funciona sin verificar dominio propio.
# Con misello.com.mx ya verificado en Resend: "Sello <hola@misello.com.mx>".
RESEND_FROM_ADDRESS=

# Destinatario del formulario de dudas/feedback de la landing
# (lib/feedback/actions.ts). Tiene que ser una dirección que SÍ leas: sin
# esto, el formulario le responde error a quien escribe.
# hola@misello.com.mx ya tiene buzón propio (MX de Hostinger), así que sirve
# como destino. El correo sale de esa misma dirección y llega a ella; el
# replyTo lleva el correo de quien escribió, así que responder desde la
# bandeja le contesta a esa persona, no a ti mismo.
FEEDBACK_TO_ADDRESS=

# Crons (app/api/cron/expire-events y app/api/cron/cleanup-anonymous) — cualquier string
# secreto; Vercel Cron lo manda como header Authorization: Bearer <esto>.
CRON_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=misello.com.mx

# Google Maps — usada por el campo "ubicacion" del formulario (autocomplete
# de direcciones con Places) y, más adelante, por el mapa embebido en las
# plantillas. Google Cloud Console → habilitar "Places API (New)" y "Maps
# Embed API" → crear una API key restringida por HTTP referrer
# (misello.com.mx/*, *.misello.com.mx/*, localhost:3000/* en dev). Es segura
# de exponer en el cliente porque queda restringida por dominio.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google One Tap (components/auth/LoginPanel.tsx) — el MISMO Client ID web de
# OAuth que ya está en Supabase → Authentication → Providers → Google. En
# Google Cloud Console → Credentials → ese cliente, agrega en "Authorized
# JavaScript origins": https://misello.com.mx y http://localhost:3000 (y
# http://localhost, que One Tap exige en desarrollo). Si falta, el login con
# Google cae al flujo con redirect de siempre.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Meta (Facebook/Instagram Ads) — opcional. Si faltan, el pixel no se
# renderiza y la Conversions API es un no-op: el sitio funciona igual.
# - NEXT_PUBLIC_META_PIXEL_ID: Events Manager → Orígenes de datos → tu pixel.
# - META_CAPI_ACCESS_TOKEN: en ese mismo pixel, Configuración → Conversions API
#   → "Generar token de acceso". Es un token de servidor: NUNCA con prefijo
#   NEXT_PUBLIC_, porque quedaría expuesto en el bundle del navegador.
# El Purchase sale del webhook de Stripe, no del navegador — ver
# app/api/webhooks/stripe/route.ts.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Solo para probar en Events Manager → Probar eventos. Vacío en producción,
# o los eventos reales se quedan en el modo de prueba y no optimizan nada.
META_TEST_EVENT_CODE=

# Google Search Console — token del método de verificación por meta tag
# (solo la cadena, sin la etiqueta HTML completa). Si se verifica por DNS,
# esto se deja vacío.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity — opcional. Si falta, el script no se renderiza y el
# sitio funciona igual. Clarity Dashboard → Settings → Setup → "Install
# tracking code manually" → copia solo el ID del proyecto (no el snippet).
NEXT_PUBLIC_CLARITY_ID=
